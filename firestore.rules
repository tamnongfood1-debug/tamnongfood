rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function myDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasDoc() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isRole(r) { return signed() && hasDoc() && myDoc().role == r && myDoc().approved == true; }
    function isAdmin() { return isRole('admin'); }
    function isShop() { return isRole('shop'); }
    function isShipper() { return isRole('shipper'); }

    // Tài khoản
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
      // Tự đăng ký: khách được duyệt ngay, quán/tài xế phải chờ admin. Không ai tự tạo được admin.
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.role in ['customer', 'shop', 'shipper']
        && request.resource.data.approved == (request.resource.data.role == 'customer')
        && !('shopId' in request.resource.data);
      allow update: if isAdmin()
        || (signed() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']));
      allow delete: if isAdmin();
    }

    // Quán: ai cũng xem được; admin thêm/sửa/xóa; chủ quán chỉ sửa thực đơn và trạng thái mở cửa
    match /shops/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isShop() && myDoc().shopId == id
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['menu', 'open']));
    }

    // Đơn hàng
    match /orders/{id} {
      allow create: if signed()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.shopId is string
        && request.resource.data.shopId != '';
      allow read: if signed() && (
        resource.data.userId == request.auth.uid
        || isAdmin()
        || (isShop() && myDoc().shopId == resource.data.shopId)
        || (isShipper() && (resource.data.status == 'ready' || resource.data.shipperId == request.auth.uid)));
      allow update: if isAdmin()
        || (isShop() && myDoc().shopId == resource.data.shopId
            && request.resource.data.status in ['accepted', 'ready', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
        || (isShipper() && (
            (resource.data.status == 'ready' && !('shipperId' in resource.data)
              && request.resource.data.status == 'delivering'
              && request.resource.data.shipperId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'shipperId', 'shipperName', 'shipperPhone']))
            || (resource.data.shipperId == request.auth.uid && resource.data.status == 'delivering'
              && request.resource.data.status == 'done'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))));
    }
  }
}
